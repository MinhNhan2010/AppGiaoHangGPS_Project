PORT=8787

# Các origin được phép gọi API, phân tách bằng dấu phẩy.
WEB_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Token gọi relay. Không dùng lại mật khẩu Gmail.
RELAY_TOKEN=thay-bang-token-ngau-nhien-dai

# Gmail SMTP: dùng App Password, không dùng mật khẩu Gmail thường.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
